# ==============================================================================
# JevBeez Environment Configuration Template
# Copy this file to .env and populate the required API keys.
# NEVER commit your actual .env file or sensitive credentials to version control.
# ==============================================================================

# Server & Network Configuration
PORT=8080
CORS_ORIGIN=*

# Redis Cache Service
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# AI Decision Model (Required)
# Obtain your API key from TypeSafe: https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Live Search & Evidence Retrieval (At least one required)
# Tavily Search API: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
# Firecrawl Search & Scraper API: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Frontend Internal SSR Proxy (Nuxt to Go API)
API_INTERNAL_URL=http://api:8080
